# Examples from <https://www.w3.org/TR/prov-o/>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
prefix prov: <http://www.w3.org/ns/prov#>
prefix : <https://example.net/terms/>
base <https://example.org/>

graph <shared> {

  <derek> a prov:Agent .
  <tutorial_blog> a prov:Plan, prov:Entity .
  <illustrationist> a prov:Role .

  <aggregated_by_regions> a prov:Entity .

  <use_of_aggregated_data> a prov:Usage;
    prov:entity <aggregated_by_regions>;  # subpof prov:influencer, based on rdf:object
    prov:atTime "2011-07-14T03:03:03Z"^^xsd:dateTime .

  <generation_of_bar_chart> a prov:Generation;
    prov:activity <illustration_activity>;  # subpof prov:influencer, based on rdf:object
    prov:atTime "2011-07-14T15:52:14Z"^^xsd:dateTime .

}

graph <alternative/using-qualification> {

  ## Example 8:
  <illustration_activity> a prov:Activity;
    prov:usageQualification <use_of_aggregated_data> ;
    ## Example 9:
    prov:qualifiedAssociation [ a prov:Association;
        prov:agent   <derek>;  # subpof prov:influencer, based on rdf:object
        prov:hadRole <illustrationist>;
        prov:hadPlan <tutorial_blog>
      ] .

  ## Example 10:
  <bar_chart> a prov:Entity;
    prov:qualifiedGeneration <generation_of_bar_chart> ;
    # Example 11:
    prov:qualifiedDerivation [ a prov:Derivation;
        prov:entity        <aggregated_by_regions>;  # subpof prov:influencer, based on rdf:object
        prov:hadActivity   <aggregating_activity>;
        prov:hadUsage      <use_of_aggregated_data>;
        prov:hadGeneration <generation_of_bar_chart>
      ] .

}

graph <alternative/using-reifier-annotation> {

  ## Example 8:
  <illustration_activity> a prov:Activity;
    prov:used <aggregated_by_regions> ~ <use_of_aggregated_data> ;
    ## Example 9:
    prov:wasAssociatedWith <derek> {|
        prov:hadRole <illustrationist>;
        prov:hadPlan <tutorial_blog>
      |} .

  ## Example 10:
  <bar_chart> a prov:Entity;
    prov:wasGeneratedBy <illustration_activity> ~ <generation_of_bar_chart> ;
    # Example 11:
    prov:wasDerivedFrom <aggregated_by_regions> {|
        prov:hadActivity <aggregating_activity>;
        prov:hadUsage <use_of_aggregated_data>;
        prov:hadGeneration <generation_of_bar_chart>
      |} .

}
